# Copy to .env and fill in — never commit the result.
# Read automatically by `docker compose`; `./gradlew bootRun` needs them in the environment.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# GitHub OAuth app, with http://localhost:9000 as homepage and callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keycloak admin console at http://localhost:8080 — local development only.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Keycloak builds the realm on first start from keycloak/splitter-realm.json and
# takes the values below from here, so they are yours to choose. The realm name
# is not among them: Keycloak derives it from that file's name.
KEYCLOAK_CLIENT_ID=splitter-app
KEYCLOAK_CLIENT_SECRET=

# The account that same import creates, for signing in as.
KEYCLOAK_DEV_USER=
KEYCLOAK_DEV_PASSWORD=
