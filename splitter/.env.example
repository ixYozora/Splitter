# Copy to .env and fill in — never commit the result.
# Read automatically by `docker compose`; `./gradlew bootRun` needs them in the environment.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# GitHub OAuth app, with http://localhost:9000 as homepage and callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keycloak admin console at http://localhost:8080 — local development only.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Confidential client in the "splitter" realm. Keycloak creates both on first
# start from keycloak/splitter-realm.json and takes the values from here, so
# they are yours to choose. The realm name itself is fixed by
# KEYCLOAK_ISSUER_URI in docker-compose.yml.
KEYCLOAK_CLIENT_ID=splitter-app
KEYCLOAK_CLIENT_SECRET=

# Password of the "yozora" account that the same import creates.
KEYCLOAK_DEV_PASSWORD=
