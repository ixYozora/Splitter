# Copy to .env and fill in — never commit the result.
# Read automatically by `docker compose`; `./gradlew bootRun` needs them in the environment.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# GitHub OAuth app, with http://localhost:9000 as homepage and callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keycloak admin console at http://localhost:8080 — local development only.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Confidential client in the "splitter" realm; the secret is on its
# Credentials tab. The realm name is fixed by KEYCLOAK_ISSUER_URI in
# docker-compose.yml.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
