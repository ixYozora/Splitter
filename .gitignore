### Local environment ###
# Credentials for docker compose / local runs — never commit.
.env
.env.*
!.env.example

### IntelliJ IDEA ###
# Shared project config (checkstyle, google-java-format, gradle, vcs, misc) is
# intentionally committed; everything below is per-developer or holds credentials.
.idea
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/httpRequests/
.idea/dictionaries/
.idea/contentModel.xml
.idea/dynamic.xml
.idea/uiDesigner.xml
# Database tool: dataSources.local.xml stores connection passwords.
.idea/dataSources/
.idea/dataSources.local.xml
.idea/dataSources.ids
.idea/sqlDataSources.xml
# Module files are regenerated by the Gradle import.
*.iml
*.iws
*.ipr

### Build output ###
build/
.gradle/
out/

